# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
release/
*.egg-info/
.eggs/

# Test / coverage / lint caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# IDE / editor
.idea/
.vscode/

# Environment files. `.env.build` holds the mail account this build is
# packaged with, so the same rule that keeps `.env` out keeps it out.
.env
.env.*
!.env.example

# The provisioning bundle, generated by scripts/provision_build.py. It
# carries the mail password, so it must never be committed — it is
# produced during the build and lives only in the build output and, when
# a developer wants a working "Forgot password", in their own checkout.
provisioning.dat

# Local database files, and the copies taken before a schema migration
data/*.db
data/*.sqlite3
data/*.backup
*.db
*.sqlite3

# Local session / sign-in state. sign_in.json holds the remembered email
# address, so it is personal data and must not be committed. (The matching
# password lives in the OS credential vault, never in the project.)
data/session.json
data/sign_in.json

# UI assets generated at runtime (see presentation/theme/assets.py)
data/ui/

# Licence state belonging to this installation, not to the project
data/license.json
data/installation.json

# Licence signing material. The private key must never reach this
# repository — these patterns are a backstop, not the plan: keep it in a
# folder outside the checkout (see scripts/licensing/keygen.py).
*.pem
*.key
*.lic

# The runtime configuration belonging to this installation. Anchored to
# the repository root on purpose: an unanchored "config/" would also
# match the app/config package.
/config/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Alembic temporary / local files if any
alembic/*.pyc